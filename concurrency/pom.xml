<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.erano.com</groupId>
        <artifactId>JavaStudy</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>concurrency</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>p1-why-concurrency</module>
        <module>p2-thinking-about-concurrency</module>
    </modules>

    <properties>
        <jdk.version>27</jdk.version>
        <maven.compiler.source>${jdk.version}</maven.compiler.source>
        <maven.compiler.target>${jdk.version}</maven.compiler.target>
        <maven.compiler.release>${jdk.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Tüm alt modüllerin Javadoc'unu tek sitede birleştirir:
            mvn javadoc:aggregate   (concurrency klasöründen)
        Çıktı: concurrency/target/reports/apidocs
        Yeni bir alt proje eklendiğinde aşağıdaki <groups> listesine bir <group> ekleyin.
    -->
    <build>
        <plugins>
            <!--
                Maven hangi JDK ile çalışırsa çalışsın (JAVA_HOME), derleme ve Javadoc için
                sistemde kurulu JDK'lar arasından uygun olanı otomatik seçer.
                (/usr/lib/jvm, C:\Program Files\..., ~/.jdks, SDKMAN vb. taranır)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>select-jdk-toolchain</goal>
                        </goals>
                        <configuration>
                            <version>[${maven.compiler.source},)</version>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doctitle>Concurrency Notes</doctitle>
                    <windowtitle>Concurrency Notes</windowtitle>
                    <overview>${project.basedir}/src/main/javadoc/overview.html</overview>
                    <doclint>all,-missing</doclint>
                    <groups>
                        <group>
                            <title>p1-why-concurrency</title>
                            <packages>me.erano.com.concurrency.why*</packages>
                        </group>
                        <group>
                            <title>p2-thinking-about-concurrency</title>
                            <packages>me.erano.com.concurrency.resources*</packages>
                        </group>
                    </groups>
                </configuration>
            </plugin>
        </plugins>
    </build>



</project>